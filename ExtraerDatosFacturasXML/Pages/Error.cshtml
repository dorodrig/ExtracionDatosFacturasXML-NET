@page
@model ErrorModel
@{
    ViewData["Title"] = "Error - Fasecolda";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/fasecolda-styles.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="page-wrapper">
        <div class="card">
            <div class="error-container">
                <!-- Icono de Error -->
                <div class="error-icon">
                    <i class="bi bi-x-circle-fill" style="color: var(--error);"></i>
                </div>
                
                <!-- Título -->
                <h1 class="error-title">Ha ocurrido un error</h1>
                
                <!-- Mensaje -->
                <p class="error-message">
                    Lo sentimos, ha ocurrido un error al procesar su solicitud.<br />
                    Por favor, intente nuevamente o contacte al administrador del sistema.
                </p>

                <!-- Request ID (solo en desarrollo) -->
                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>ID de Solicitud:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <!-- Botón de Regreso -->
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="bi bi-house-door"></i>
                    <span>Volver al inicio</span>
                </a>

                <!-- Footer -->
                <div class="card-footer mt-5">
                    <div class="logo-container">
                        <img src="https://www.fasecolda.com/wp-content/themes/fasecolda/assets/img/logo-fasecolda.svg" 
                             alt="Fasecolda Logo" 
                             class="logo"
                             style="max-width: 200px;" />
                    </div>
                    <p class="text-muted mt-3">
                        Federación de Aseguradores de Colombia
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

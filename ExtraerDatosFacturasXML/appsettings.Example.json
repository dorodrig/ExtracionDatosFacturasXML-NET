{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VisualVault": {
    "Environment": "sa2",
    "BaseUrl": "https://sa2.visualvault.com",
    "Username": "YOUR_API_USERNAME_HERE",
    "Password": "YOUR_API_PASSWORD_HERE",
    "CustomerAlias": "YOUR_CUSTOMER_ALIAS",
    "DatabaseAlias": "YOUR_DATABASE_ALIAS",
    "FormTemplateId": "YOUR_FORM_TEMPLATE_ID_GUID",
    "SuccessRedirectUrl": "https://sa2.visualvault.com/app/YOUR_CUSTOMER/YOUR_DATABASE/FormDataDetails"
  },
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".xml" ],
    "MaxConcurrentProcessing": 5
  }
}
